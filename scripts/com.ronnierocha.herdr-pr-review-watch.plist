<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ronnierocha.herdr-pr-review-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/ronnierocha/Documents/Development/cmux-harness/scripts/herdr_pr_review_watch.py</string>
        <string>--loop</string>
        <string>30</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ronnierocha/Documents/Development/cmux-harness</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/ronnierocha</string>
        <key>PATH</key>
        <string>/Users/ronnierocha/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ronnierocha/Library/Logs/herdr-pr-review-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ronnierocha/Library/Logs/herdr-pr-review-watch.error.log</string>
</dict>
</plist>
